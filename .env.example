# Copy this file to .env and fill only the broker you plan to use.
# Never commit .env or paste secrets into chat.

TRADING_MODE=paper

# Optional PEM file containing a trusted private/network CA. Verification stays enabled.
TRADING_CA_BUNDLE=

ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PIN=
ANGEL_ONE_TOTP_SECRET=

# Optional mobile alerts for Purple Touch / future alert workflows.
# Create a bot with Telegram BotFather, paste the token here, then set your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Separate destination for NIFTY Desk entry/exit alerts. The bot token may be
# the same bot, but use a different chat/group id to keep NIFTY alerts isolated.
NIFTY_TELEGRAM_BOT_TOKEN=
NIFTY_TELEGRAM_CHAT_ID=

# Optional separate destinations; if blank, index alerts use the NIFTY destination.
BANKNIFTY_TELEGRAM_BOT_TOKEN=
BANKNIFTY_TELEGRAM_CHAT_ID=
SENSEX_TELEGRAM_BOT_TOKEN=
SENSEX_TELEGRAM_CHAT_ID=

# Dedicated F&O bullish/bearish pullback alerts. No fallback to index/Purple chats.
PULLBACK_TELEGRAM_BOT_TOKEN=
PULLBACK_TELEGRAM_CHAT_ID=

# Optional NIFTY Setup Lab paper alerts. No fallback to another scanner's chat.
NIFTY_LAB_TELEGRAM_BOT_TOKEN=
NIFTY_LAB_TELEGRAM_CHAT_ID=
